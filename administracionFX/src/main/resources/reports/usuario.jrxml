	<query language="SQL"><![CDATA[SELECT usuario,CONCAT_WS(' ',
	NULLIF(primer_nombre,' '),
	NULLIF(segundo_nombre,' '),
	NULLIF(primer_apellido,' ') ) as nombre_completo
FROM USUARIO]]></query>
