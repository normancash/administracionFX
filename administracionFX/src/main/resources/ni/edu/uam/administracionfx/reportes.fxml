<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.administracionfx.controller.ReporteController"
      alignment="CENTER"
      spacing="20"
      prefHeight="300"
      prefWidth="450">
    <padding>
        <Insets top="30"
                bottom="30"
                left="30"
                right="30"
    </padding>
    <Label text="GENERACION DE REPORTES"
           style="-fx-font-size:22px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #243B55;"/>
    <Label text="Seleccione el formato de exportacion"
           style="-fx-font-size:13px;
                  -fx-text-fill: #64748B;"/>
    <Button fx:id="btnPDF"
            text="Exportar a PDF"
            onAction="#exportarPDF"
            prefWidth="220"
            prefHeight="42"
            style = "-fx-background-color: #2563EB;
                     -fx-text-fill: white;
                     -fx-font-size:14px;
                     -fx-background-radius: 8;
                     -fx-cursor: hand;"/>
    <Button fx:id="btnExcel"
            text="Exportar a Excel"
            onAction="#exportarPDF"
            prefWidth="220"
            prefHeight="42"
            style = "-fx-background-color: #16A34A;
                     -fx-text-fill: white;
                     -fx-font-size:14px;
                     -fx-background-radius: 8;
                     -fx-cursor: hand;"/>
</VBox>
